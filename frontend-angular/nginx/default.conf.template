server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Resuelve `backend` con el DNS de Docker en cada petición: si el contenedor del backend se recrea
    # y cambia de IP, nginx no se queda apuntando a la anterior.
    resolver 127.0.0.11 valid=10s;

    # La API del backend: mismo origen para el navegador, sin CORS.
    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Los archivos con hash en el nombre no cambian nunca: se cachean por un año.
    location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html nunca se cachea: así un despliegue nuevo se ve al recargar.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Rutas de la SPA (/login, /inventory…): las resuelve Angular en el navegador.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
