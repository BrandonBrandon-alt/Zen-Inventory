# =========================================================================
# SEGURIDAD — Variables de entorno y certificados
# =========================================================================
# NUNCA subir credenciales ni secretos al repositorio
.env
.env.*
*.pem
*.p12
*.jks

# =========================================================================
# Sistema operativo
# =========================================================================
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# =========================================================================
# IDEs y Editores
# =========================================================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code (configuracion local de editor, no del proyecto)
.vscode/

# Spring Tool Suite / Eclipse
.sts4-cache
.project
.classpath
.settings/
.factorypath
.apt_generated/
.springBeans

# =========================================================================
# BACKEND — Spring Boot / Java / Maven
# =========================================================================
# Compilados de Maven (SOLO la carpeta target del backend)
backend/target/

# Wrapper de Maven — MANTENER para portabilidad del proyecto
!backend/.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar

# Artefactos empaquetados — nunca subir binarios compilados
*.jar
*.war
!**/maven-wrapper.jar

# Logs de la aplicación
*.log
*.log.*

# =========================================================================
# FRONTEND — Node.js (la configuración propia está en frontend-angular/.gitignore)
# =========================================================================
# Dependencias — nunca subir node_modules (se reinstalan con npm install)
node_modules/

# Logs de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# =========================================================================
# graphify — cada desarrollador genera su grafo local (graphify update .)
# =========================================================================
graphify-out/

# Python
__pycache__/
*.pyc

# Informes de la auditoría de movimiento (design-motion-principles): se generan localmente
motion-audits/
